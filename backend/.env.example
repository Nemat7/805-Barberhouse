# Copy this file to .env and fill in the values

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Database (PostgreSQL)
DB_NAME=barbershop
DB_USER=barbershop
DB_PASSWORD=barbershop
DB_HOST=localhost
DB_PORT=5432

# OsonSMS
OSONSMS_URL=https://api.osonsms.com/sendsms_v1.php
# Token = the hex API key from OsonSMS (used as "Authorization: Bearer <token>")
OSONSMS_TOKEN=your-token-here
OSONSMS_LOGIN=your-login-here
# Sender = the registered alphanumeric name recipients see
OSONSMS_SENDER=805 BARBERS
# Set to True to actually send SMS even in DEBUG mode
OSONSMS_FORCE_SEND=False

# Production only
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
